# Copy this file to .env and fill in real values before deploying.
# docker-compose reads SECRET_KEY from the shell env; everything else here
# is consumed by backend/app/core/config.py (pydantic-settings).

ENV=production
DEBUG=false

DATABASE_URL=postgresql+psycopg2://traffic_user:traffic_pass@db:5432/traffic_db

# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=saved_models
